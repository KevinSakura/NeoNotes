<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NeoNote.VocalWorker</AssemblyName>
    <UseAppHost>false</UseAppHost>
    <OpenUtauDir>$(MSBuildThisFileDirectory)../../tools/vocals/openutau</OpenUtauDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="OpenUtau.Core"><HintPath>$(OpenUtauDir)/OpenUtau.Core.dll</HintPath></Reference>
    <Reference Include="OpenUtau.Plugin.Builtin"><HintPath>$(OpenUtauDir)/OpenUtau.Plugin.Builtin.dll</HintPath></Reference>
    <Reference Include="Serilog"><HintPath>$(OpenUtauDir)/Serilog.dll</HintPath></Reference>
    <Reference Include="Serilog.Sinks.Console"><HintPath>$(OpenUtauDir)/Serilog.Sinks.Console.dll</HintPath></Reference>
    <Reference Include="YamlDotNet"><HintPath>$(OpenUtauDir)/YamlDotNet.dll</HintPath></Reference>
    <Content Include="$(OpenUtauDir)/*.dll" Exclude="$(OpenUtauDir)/System*.dll;$(OpenUtauDir)/Microsoft.CSharp.dll;$(OpenUtauDir)/Microsoft.VisualBasic*.dll;$(OpenUtauDir)/mscor*.dll;$(OpenUtauDir)/coreclr.dll;$(OpenUtauDir)/clrjit.dll;$(OpenUtauDir)/host*.dll">
      <Link>%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(OpenUtauDir)/LICENSE*;$(OpenUtauDir)/ThirdParty*"><Link>%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
</Project>
