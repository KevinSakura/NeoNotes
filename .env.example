# 无密钥配置模板，2026-10-06 整曲阶段更新。
# 后端按需加载项目根目录 .env 的 MODEL_*；修改模板不会改变已有 .env。
# 真实密钥只填 .env，不填本模板或聊天窗口，前端不持有密钥。
# APP_*、音频路径、AUDIO_* 仍为预留；监听、data 与工具路径由代码/脚本固定。
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATA_DIR=./data

MODEL_MOCK=true
MODEL_PROVIDER=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_OUTPUT_MODE=json_object
# 单次超时 10..300 秒，当前默认180；不自动重试。
MODEL_TIMEOUT_SECONDS=180
MODEL_MAX_RETRIES=0
MODEL_MAX_TOKENS=32768
# 本机已接入的音频工具；未来配置加载时使用，当前路径由 backend/app/resources.py 固定。
FFMPEG_PATH=./tools/ffmpeg-9.0.2-essentials_build/bin/ffmpeg.exe
FFPROBE_PATH=./tools/ffmpeg-9.0.2-essentials_build/bin/ffprobe.exe
FLUIDSYNTH_PATH=./tools/fluidsynth-v2.6.1-win10-x64-cpp11/bin/fluidsynth.exe
SOUNDFONT_PATH=./tools/soundfonts/GeneralUser-GS-main/GeneralUser-GS.sf2